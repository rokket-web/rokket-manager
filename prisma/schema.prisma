generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAST
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum BillingType {
  HOURLY
  FLAT_FEE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FileStatus {
  PENDING
  READY
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(STAFF)
  active        Boolean  @default(true)
  // One portal user per client (unique).
  clientId      String?  @unique
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions           Session[]
  projectMemberships ProjectMember[]
  assignedTasks      Task[]          @relation("TaskAssignee")
  timeEntries        TimeEntry[]
  accounts           Account[]
  auditLogs          AuditLog[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Client {
  id           String       @id @default(cuid())
  name         String
  status       ClientStatus @default(LEAD)
  website      String?
  industry     String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  billingEmail String?
  // Tax rate in basis points (825 = 8.25%). null = use the default tax rate setting; 0 = tax exempt.
  taxRateBps   Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  contacts   Contact[]
  notes      Note[]
  activities Activity[]
  tags       ClientTag[]
  portalUser User?
  projects   Project[]
  files      FileAsset[]
  quotes     Quote[]
  invoices   Invoice[]
  messages   Message[]
  emailLogs  EmailLog[]

  @@index([status])
  @@index([name])
  @@index([createdAt])
}

enum EmailStatus {
  SENT // accepted by Mailgun (not yet confirmed delivered)
  DELIVERED
  FAILED // rejected when we tried to send
  BOUNCED // permanent failure reported by the receiving server
  COMPLAINED // recipient marked it as spam
}

/// One row per outgoing email. Never stores the body or attachments.
model EmailLog {
  id            String      @id @default(cuid())
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  kind          String // invoice, quote, admin_email, message_notice, admin_notice, portal_link, quote_response, other
  toEmail       String
  subject       String
  status        EmailStatus
  detail        String? // failure / bounce reason, short
  providerId    String?     @unique // Mailgun message id (without angle brackets)
  triggeredById String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([createdAt])
  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

/// One running conversation per client. Visible to the client in the portal and to admins on the client page.
model Message {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId   String?
  fromClient Boolean
  body       String
  // When the OTHER side first saw it (admin read a client message / client read an admin message).
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([clientId, createdAt])
  @@index([clientId, fromClient, readAt])
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([email])
}

// Internal-only notes. Never exposed to the client portal.
model Note {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique // stored lowercase
  clients ClientTag[]
}

model ClientTag {
  clientId String
  tagId    String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId])
}

model Activity {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorId   String?
  type      String // e.g. client.created, client.status_changed, contact.added, note.added
  summary   String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model Project {
  id              String        @id @default(cuid())
  clientId        String
  // Restrict: a client with projects cannot be deleted.
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name            String
  description     String?
  status          ProjectStatus @default(PLANNING)
  budgetCents     Int?
  currency        String        @default("USD")
  hourlyRateCents Int?
  // HOURLY bills logged time; FLAT_FEE bills flatFeeCents in installments (BillingInstallment).
  billingType     BillingType   @default(HOURLY)
  flatFeeCents    Int?
  startDate       DateTime?     @db.Date
  dueDate         DateTime?     @db.Date
  visibleToClient Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  members      ProjectMember[]
  milestones   Milestone[]
  tasks        Task[]
  timeEntries  TimeEntry[]
  files        FileAsset[]
  quotes       Quote[]
  invoices     Invoice[]
  installments BillingInstallment[]

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Milestone {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          MilestoneStatus @default(PENDING)
  dueDate         DateTime?       @db.Date
  position        Int             @default(0)
  billableCents   Int?
  visibleToClient Boolean         @default(false)
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tasks Task[]

  @@index([projectId, position])
  @@index([dueDate])
}

model Task {
  id              String     @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId     String?
  milestone       Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        Priority   @default(MEDIUM)
  assigneeId      String?
  assignee        User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate         DateTime?  @db.Date
  visibleToClient Boolean    @default(false)
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  comments    TaskComment[]
  timeEntries TimeEntry[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([milestoneId])
  @@index([dueDate])
}

model TaskComment {
  id              String   @id @default(cuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId        String?
  body            String
  visibleToClient Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([taskId, createdAt])
}

model TimeEntry {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  // null while a timer is running. At most one running entry per user (partial unique index in the migration).
  endedAt     DateTime?
  minutes     Int          @default(0)
  description String?
  billable    Boolean      @default(true)
  // Hourly rate in cents, snapshotted when the entry is created so later rate changes do not rewrite history.
  rateCents   Int          @default(0)
  invoiceLine InvoiceLine?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId, startedAt])
  @@index([userId, startedAt])
}

model FileAsset {
  id              String     @id @default(cuid())
  clientId        String
  client          Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storageKey      String     @unique
  name            String
  size            Int
  mime            String
  status          FileStatus @default(PENDING)
  uploadedById    String?
  visibleToClient Boolean    @default(false)
  createdAt       DateTime   @default(now())

  @@index([clientId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Billing (Phase 4). Money = integer cents + ISO currency. Quantities are
// thousandths (1500 = 1.5) so hours can be fractional without floats.
// Totals are computed by src/lib/billing.ts and stored; tax rate is snapshotted.
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CHANGES_REQUESTED // client asked for edits; admin revises and re-sends
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  STRIPE
  MANUAL
}

enum PaymentStatus {
  PENDING // Stripe checkout opened; the client may still be paying or may have abandoned it
  PROCESSING // checkout completed but funds not settled yet (e.g. bank transfer)
  SUCCEEDED
  FAILED
  REFUNDED
}

/**
 * Gapless counters (invoice, quote). Incremented inside the creating transaction.
 */
model Sequence {
  key   String @id
  value Int    @default(0)
}

model Quote {
  id            String      @id @default(cuid())
  // Assigned when the quote is sent (gapless); null while DRAFT.
  number        String?     @unique
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status        QuoteStatus @default(DRAFT)
  currency      String      @default("USD")
  title         String?
  notes         String?
  terms         String?
  validUntil    DateTime?   @db.Date
  taxRateBps    Int         @default(0)
  subtotalCents Int         @default(0)
  taxCents      Int         @default(0)
  totalCents    Int         @default(0)
  sentAt        DateTime?
  respondedAt   DateTime?
  // Unguessable token for the (Phase 5) client accept/decline link.
  publicToken   String      @unique @default(cuid())
  invoice       Invoice?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lines   QuoteLine[]
  history QuoteNote[]

  @@index([clientId])
  @@index([status])
}

/// History of a quote's back-and-forth: each client response (with an optional note) and each revised re-send.
model QuoteNote {
  id         String   @id @default(cuid())
  quoteId    String
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  authorId   String?
  fromClient Boolean
  action     String // accepted | declined | changes_requested | revised
  body       String?
  createdAt  DateTime @default(now())

  @@index([quoteId, createdAt])
}

model QuoteLine {
  id             String  @id @default(cuid())
  quoteId        String
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  quantityMilli  Int     @default(1000)
  unitPriceCents Int
  taxable        Boolean @default(true)
  amountCents    Int

  @@index([quoteId, position])
}

model Invoice {
  id            String        @id @default(cuid())
  // Assigned when the invoice is sent (gapless); null while DRAFT.
  number        String?       @unique
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quoteId       String?       @unique
  quote         Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("USD")
  notes         String?
  terms         String?
  issueDate     DateTime?     @db.Date
  // "Overdue" is derived: status SENT/PARTIALLY_PAID and dueDate in the past.
  dueDate       DateTime?     @db.Date
  taxRateBps    Int           @default(0)
  subtotalCents Int           @default(0)
  taxCents      Int           @default(0)
  totalCents    Int           @default(0)
  // Denormalised sum of SUCCEEDED payments minus refunds; updated with each payment write.
  paidCents     Int           @default(0)
  sentAt        DateTime?
  paidAt        DateTime?
  publicToken   String        @unique @default(cuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines       InvoiceLine[]
  payments    Payment[]
  installment BillingInstallment?

  @@index([clientId])
  @@index([status, dueDate])
}

model InvoiceLine {
  id             String     @id @default(cuid())
  invoiceId      String
  invoice        Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  quantityMilli  Int        @default(1000)
  unitPriceCents Int
  taxable        Boolean    @default(true)
  amountCents    Int
  // Set when the line was generated from billable time; prevents double-billing.
  timeEntryId    String?    @unique
  timeEntry      TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  @@index([invoiceId, position])
}

model Payment {
  id                    String        @id @default(cuid())
  invoiceId             String
  invoice               Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  method                PaymentMethod
  status                PaymentStatus @default(PENDING)
  amountCents           Int
  currency              String        @default("USD")
  reference             String?
  paidAt                DateTime?
  // Stripe ids; unique so webhook retries are idempotent.
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([invoiceId])
}

/**
 * Processed Stripe webhook event ids, for idempotency.
 */
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

/**
 * One slice of a flat-fee project's price. basisPoints is the share of the fee (4000 = 40%); amountCents is stored
 * so invoiced installments never change. Once invoiceId is set the row is locked; voiding/deleting the invoice frees it.
 */
model BillingInstallment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position    Int
  label       String
  basisPoints Int
  amountCents Int
  invoiceId   String?  @unique
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, position])
}
