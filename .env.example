# --- Database (Neon) ---
# Pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full"
# Direct, non-pooled connection. Used ONLY by Prisma migrations / CLI.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=verify-full"

# --- Auth (Better Auth) ---
# At least 32 chars: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app (http://localhost:3100 locally; must match the origin in the browser exactly)
BETTER_AUTH_URL="http://localhost:3100"

# --- Seed (dev only) ---
# Password given to all seeded sample users (min 12 chars). Never use in production.
SEED_PASSWORD=""

# --- Billing (Phase 4) ---
# Stripe secret key (sandbox: sk_test_...). Server only.
STRIPE_SECRET_KEY=""
# Webhook signing secret. Local: `stripe listen --forward-to localhost:3100/api/webhooks/stripe` prints whsec_...
STRIPE_WEBHOOK_SECRET=""

# --- Email (Mailgun, US region) ---
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
# From address for quotes/invoices, e.g. "Rokket <billing@mg.example.com>"
MAIL_FROM=""
# Dev only: MAIL_DRIVER=log logs outgoing mail (recipient, subject) instead of sending. Ignored in production.
# MAIL_DRIVER=log
