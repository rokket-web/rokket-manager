# --- Database (Neon) ---
# Pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct, non-pooled connection. Used ONLY by Prisma migrations / CLI.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Better Auth) ---
# At least 32 chars: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app (http://localhost:3000 locally)
BETTER_AUTH_URL="http://localhost:3000"

# --- Seed (dev only) ---
# Password given to all seeded sample users (min 12 chars). Never use in production.
SEED_PASSWORD=""
